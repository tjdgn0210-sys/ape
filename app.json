{
  "expo": {
    "name": "못지키면 유인원",
    "slug": "mot-jikimyeon-yuinwon",
    "version": "1.0.0",
    "scheme": "yuinwon",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yuinwon.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.yuinwon.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-foreground.png",
        "monochromeImage": "./assets/app/monochrome.png",
        "backgroundColor": "#F5F5F5"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F5",
          "dark": {
            "backgroundColor": "#0B0B0B"
          }
        }
      ],
      "expo-font",
      "expo-notifications",
      "expo-live-activity"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/app/icon.png"
  }
}
