{
  "expo": {
    "name": "못지키면 유인원",
    "slug": "mot-jikimyeon-yuinwon",
    "version": "1.0.0",
    "scheme": "yuinwon",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yuinwon.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.yuinwon.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-live-activity"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}